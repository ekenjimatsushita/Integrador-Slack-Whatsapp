# Leave Slack credentials empty for a local Compose smoke test.
SLACK_SIGNING_SECRET=
SLACK_TOKEN=
SLACK_CHAT_POST_MESSAGE_URL=https://slack.com/api/chat.postMessage
SLACK_WEBHOOK_URL=
SLACK_API_URL=https://slack.com/api/files.upload

MONGODB_URI=mongodb://mongodb:27017/slackwhatsapp
PORT=3000

# Keep WhatsApp disabled until a dedicated lab account is configured.
WHATSAPP_ENABLED=false
WHATSAPP_CHANNEL_NAME=
WHATSAPP_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
